@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h3>OCP Payment System</h3>
    <hr />

    <div class="row">
        @foreach (var item in Model.Approval)
        {
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h6>
                            @(item.ApprovalName)
                        </h6>
                        <h2>@item.Total</h2>
                    </div>
                </div>
            </div>
        }

    </div>
</div>