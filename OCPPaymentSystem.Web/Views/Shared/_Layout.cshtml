<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>


<body>

    <div class="top-header">

        <div class="header-left">

            <span class="system-title">
                OCP PAYMENT SYSTEM
            </span>

        </div>


        <div class="header-right">

            Welcome,

            <b>

            @using System.Text.Json
            @using OCPPaymentSystem.Web.Models

                @{
                    @using OCPPaymentSystem.Web.Helpers

                    LoginUser? user =
                        Context.Session.GetObject<LoginUser>("CurrentUser");
                }

                @(
                    user?.fldUserId + " - " +
                    user?.fldName + " - " +
                    user?.BusinessTitle
                )


            </b>

        </div>

    </div>


    <!-- ============================= -->
    <!-- MENU BAR -->
    <!-- ============================= -->


    <div class="menu-bar">

        <a asp-controller="Home"
           asp-action="Index">
            Dashboard
        </a>


        <a asp-controller="Memo"
           asp-action="Index">
            Input / Approve Memo
        </a>


        <a asp-controller="MemoSearch"
           asp-action="Index">
            Search Memo
        </a>

        <a asp-controller="PriceRange"
            asp-action="Index">
            Master Price Range
        </a>

        <a asp-controller="Login"
           asp-action="Logout">
            Logout
        </a>

    </div>



    <div class="main-container">

        @RenderBody()

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>
</html>