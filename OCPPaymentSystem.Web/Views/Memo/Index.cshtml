@{
    ViewData["Title"] = "Memo";
}

@using OCPPaymentSystem.Web.Helpers
@using OCPPaymentSystem.Web.Models

@{
    LoginUser? user =
        Context.Session.GetObject<LoginUser>("CurrentUser");
}

<script>
    const currentUser = {
        userId: "@user?.fldUserId",
        approvalLevel: @user?.ApprovalLevel,
        companyCode: "@user?.CompanyCode",
        unitCode: "@user?.UnitCode"
    };
</script>

<div class="panel-box">
    <div class="panel-title">MEMO LIST</div>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th width="50">No</th>
                <th width="80">Company</th>
                <th>Supplier</th>
                <th width="120">Date</th>
                <th width="140">Amount</th>
                <th width="220">Memo No</th>
                <th width="180">Status</th>
            </tr>
        </thead>
        <tbody id="tblMemo">
        </tbody>
    </table>
</div>

<div class="panel-box">
 <div class="panel-title">MEMO DETAIL</div>
    <table class="table table-borderless">
        <tr>
            <td class="memo-label">Company</td>
            <td>
                <input type="hidden" id="OpenMemoNo" value="@ViewBag.MemoNo" />
                <input type="hidden" id="MemoNo" />
                <input type="hidden" id="ApprovalLevel" value="@user?.ApprovalLevel" />
                <input type="hidden" id="MillCode" />
                <select id="Company" class="form-select"></select>
            </td>
            <td width="220"></td>
        </tr>
        <tr>
            <td>Supplier</td>
            <td><select class="form-select" id="Supplier"></select></td>
            <td>
                <button type="button"
                        id="btnSDGWeigh"
                        class="btn btn-primary">

                    SDGWeigh Checking

                </button>
            </td>
        </tr>
        <tr>
            <td>Date</td>
            <td><input type="date" class="form-control" id="MemoDate" /></td>
        </tr>
        <tr>
            <td>Amount</td>
            <td><input class="form-control" id="Amount" /></td>
        </tr>
        <tr>
            <td>Invoice</td>
            <td>
                <div class="input-group">

                    <input id="Invoice"
                           class="form-control"
                           readonly />

                    <button id="btnInvoice"
                            class="btn btn-secondary"
                            type="button">
                        ...
                    </button>

                    <input type="file"
                           id="fileInvoice"
                           hidden />

                </div>
                <input type="file" id="fileInvoice" hidden />
            </td>
        </tr>
        <tr>
            <td>BAP</td>
            <td>
                <div class="input-group">

                    <input id="BAP"
                           class="form-control"
                           readonly />

                    <button id="btnBAP"
                            class="btn btn-secondary"
                            type="button">
                        ...
                    </button>

                    <input type="file"
                           id="fileBAP"
                           hidden />

                </div>
                <input type="file" id="fileBAP" hidden />
            </td>
        </tr>
        <tr>
            <td>Faktur Pajak</td>
            <td>
                <div class="input-group">

                    <input id="FakturPajak"
                           class="form-control"
                           readonly />

                    <button id="btnFakturPajak"
                            class="btn btn-secondary"
                            type="button">
                        ...
                    </button>

                    <input type="file"
                           id="fileFakturPajak"
                           hidden />

                </div>
                <input type="file" id="fileFaktur" hidden />
            </td>
        </tr>
        <tr>
            <td>Remarks</td>
            <td><textarea rows="5" class="form-control" id="Remarks"></textarea></td>
        </tr>
    </table>
    <br />

    <div class="card mt-3">
        <div class="card-header"
             style="cursor:pointer"
             data-bs-toggle="collapse"
             data-bs-target="#sdgDetailBody">
            <b>SDGWeigh Detail</b>
            <span id="sdgSummary"
                  class="float-end">
            </span>
        </div>

        <div id="sdgDetailBody"
             class="collapse">
            <div class="card-body">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Ticket</th>
                            <th>Lorry</th>
                            <th>Driver</th>
                            <th>Bunch</th>
                            <th>Weight In</th>
                            <th>Weight Out</th>
                            <th>Nett</th>
                            <th>Deduction</th>
                        </tr>
                    </thead>
                    <tbody id="sdgDetailList">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <br />
    <button id="btnNew" class="btn btn-primary btn-ocp">New</button>
    <button id="btnSave" class="btn btn-primary btn-ocp">Save</button>
    <button id="btnSubmit" class="btn btn-primary btn-ocp">Submit</button>
    <button id="btnDelete" class="btn btn-primary btn-ocp">Delete</button>
    <button id="btnApprove" class="btn btn-success btn-ocp">Approve</button>
    <button id="btnReject" class="btn btn-danger btn-ocp">Reject</button>
    @section Scripts
    {
        <script src="~/js/memo.js"
                asp-append-version="true">
        </script>
    }
</div>